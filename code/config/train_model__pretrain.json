{
	// dataset details
	"dataset_type": "tsv",
	"train_dataset": "../../data/movie_subs/dune_part_1/train.tsv",
	"val_dataset": "../../data/movie_subs/dune_part_1/val.tsv",
	"train_dataset_size": -1,
	"val_dataset_size": -1,

	// tokenizer details
	"tokenizer": "../../logs/dune_part_1/tokenizer__full/",

	// output details
	"output_dir": "../../logs/dune_part_1/model__5/",

	// model details
	// either build from scratch or load from ckpt
	"model_dir": null,
	"model_config": {
		"model_dim": 512,
		"hidden_dim": 1024,
		"head_dim": 64,
		"latent_attn_dim": 128, // set null if don't want mhla
