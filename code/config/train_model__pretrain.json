	// opt hyper params
	"learning_rate": 1e-4,
	"weight_decay": 1e-3,
	"min_learning_rate": 1e-7,
	"ratio_warmup_steps": 0.05,
	"ratio_anneal_steps": 0.95, 
	"max_gradient_norm": 10.0,

	// other cosmetic stuff
	"eval_frequency": 64,
}
